<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Automation Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.saucedemo.tests.BaseTest"/>
    </listeners>

    <test name="Purchase Flow">
        <classes>
            <class name="com.saucedemo.tests.PurchaseProductTest"/>
        </classes>
    </test>

    <test name="Cart Management">
        <classes>
            <class name="com.saucedemo.tests.RemoveCartItemsTest"/>
        </classes>
    </test>

    <test name="Authentication">
        <classes>
            <class name="com.saucedemo.tests.LogoutTest"/>
        </classes>
    </test>

    <test name="Invalid Login">
        <parameter name="username" value="standard_user"/>
        <parameter name="password" value="wrong_password"/>
        <parameter name="expectedErrorMessage" value="Epic sadface: Username and password do not match any user in this service"/>
        <classes>
            <class name="com.saucedemo.tests.LoginNegativeTest"/>
        </classes>
    </test>

</suite>